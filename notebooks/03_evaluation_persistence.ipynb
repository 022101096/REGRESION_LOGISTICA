{
 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# 03 - Evaluación del Modelo y Persistencia Final\n",
    "\n",
    "Evaluación completa en test set: matriz de confusión, métricas, curvas ROC/PR, análisis de umbral y guardado final con métricas reales."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import sys\n",
    "sys.path.append('../')\n",
    "\n",
    "import numpy as np\n",
    "import pandas as pd\n",
    "import joblib\n",
    "import json\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "\n",
    "from src.evaluation import (\n",
    "    evaluate_model, print_metrics, plot_confusion_matrix,\n",
    "    plot_roc_curve, plot_pr_curve, plot_coefficients,\n",
    "    plot_class_distribution, save_metrics, threshold_analysis\n",
    ")\n",
    "from src.modeling import load_model, get_feature_importance\n",
    "\n",
    "plt.style.use('seaborn-v0_8-whitegrid')\n",
    "sns.set_palette(['#2E86AB', '#E94F37'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Cargar Modelo y Datos de Test"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar modelo y artefactos\n",
    "model, vectorizer, scaler, metadata = load_model()\n",
    "\n",
    "# Cargar datos de test\n",
    "X_test = joblib.load('data/processed/X_test.pkl')\n",
    "y_test = joblib.load('data/processed/y_test.pkl')\n",
    "\n",
    "print(f'Modelo cargado: {metadata[\"model_type\"]}')\n",
    "print(f'Features: {metadata[\"n_features\"]}')\n",
    "print(f'Test set: {X_test.shape[0]} muestras')\n",
    "print(f'Distribución test - Spam: {y_test.mean():.2%}')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Evaluación en Test Set"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Evaluar con threshold por defecto (0.5)\n",
    "metrics, y_pred, y_proba, cm = evaluate_model(model, X_test, y_test, threshold=0.5)\n",
    "\n",
    "# Imprimir métricas\n",
    "print_metrics(metrics)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Matriz de Confusión"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plot_confusion_matrix(cm, save_path='reports/figures/03_confusion_matrix.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Curva ROC y AUC"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plot_roc_curve(y_test, y_proba, save_path='reports/figures/03_roc_curve.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Curva Precision-Recall"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "plot_pr_curve(y_test, y_proba, save_path='reports/figures/03_pr_curve.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 6. Análisis de Umbral Óptimo"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Encontrar threshold que maximice F1\n",
    "best_threshold, best_f1 = threshold_analysis(y_test, y_proba)\n",
    "\n",
    print(f'\\nMejor threshold: {best_threshold:.3f} (F1 = {best_f1:.4f})')\n",
    "\n",
    "# Evaluar con threshold óptimo\n",
    "metrics_opt, _, _, _ = evaluate_model(model, X_test, y_test, threshold=best_threshold)\n",
    "print_metrics(metrics_opt)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 7. Coeficientes (para el informe)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar vectorizador para features\n",
    "vectorizer = joblib.load('data/processed/tfidf_vectorizer.pkl')\n",
    "feature_importance = get_feature_importance(model, vectorizer, top_n=20)\n",
    "\n",
    "plot_coefficients(feature_importance, top_n=15, save_path='reports/figures/03_coefficients.png')"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 8. Análisis de Errores (Casos límite)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Cargar textos originales de test para análisis de errores\n",
    "df = pd.read_csv('data/raw/spam.csv', encoding='latin-1')\n",
    "df = df.iloc[:, :2]\n",
    "df.columns = ['label', 'message']\n",
    "df = df.drop_duplicates().reset_index(drop=True)\n",
    "df['clean'] = df['message'].astype(str)\n",
    "\n",
    "# Split igual que en entrenamiento\n",
    "from sklearn.model_selection import train_test_split\n",
    "_, X_test_text, _, _ = train_test_split(\n",
    "    df['clean'], (df['label'] == 'spam').astype(int),\n",
    "    test_size=0.2, random_state=42, stratify=(df['label'] == 'spam').astype(int)\n",
    ")\n",
    "\n",
    "# Crear DataFrame de errores\n",
    "errors_df = pd.DataFrame({\n",
    "    'message': X_test_text.values,\n",
    "    'true_label': y_test,\n",
    "    'pred_label': y_pred,\n",
    "    'prob_spam': y_proba\n",
    "})\n",
    "\n",
    "# Falsos Positivos (Ham predicho como Spam)\n",
    "fp = errors_df[(errors_df['true_label'] == 0) & (errors_df['pred_label'] == 1)]\n",
    "print(f'Falsos Positivos (Ham → Spam): {len(fp)}')\n",
    "if len(fp) > 0:\n",
    "    print('\\nEjemplos:')\n",
    "    for _, row in fp.head(3).iterrows():\n",
    "        print(f\"  P(Spam)={row['prob_spam']:.3f} | {row['message'][:100]}...\")\n",
    "\n",
    "# Falsos Negativos (Spam predicho como Ham)\n",
    "fn = errors_df[(errors_df['true_label'] == 1) & (errors_df['pred_label'] == 0)]\n",
    "print(f'\\nFalsos Negativos (Spam → Ham): {len(fn)}')\n",
    "if len(fn) > 0:\n",
    "    print('\\nEjemplos:')\n",
    "    for _, row in fn.head(3).iterrows():\n",
    "        print(f\"  P(Spam)={row['prob_spam']:.3f} | {row['message'][:100]}...\")"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 9. Tabla Resumen de Métricas (para informe)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Tabla comparativa\n",
    "metrics_table = pd.DataFrame({\n",
    "    'Métrica': ['Accuracy', 'Precision (Spam)', 'Recall (Spam)', 'F1-Score (Spam)', 'ROC-AUC', 'PR-AUC'],\n",
    "    'Valor': [\n",
    "        metrics['accuracy'],\n",
    "        metrics['precision'],\n",
    "        metrics['recall'],\n",
    "        metrics['f1'],\n",
    "        metrics['roc_auc'],\n",
    "        metrics['pr_auc']\n",
    "    ]\n",
    "})\n",
    "metrics_table['Valor'] = metrics_table['Valor'].apply(lambda x: f'{x:.4f}')\n",
    "display(metrics_table)\n",
    "\n",
    "# Guardar tabla como CSV para informe\n",
    "metrics_table.to_csv('reports/figures/metrics_table.csv', index=False)"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 10. Guardado Final con Métricas Reales"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Actualizar metadata con métricas reales\n",
    "from src.modeling import save_model\n",
    "\n",
    "final_metrics = {\n",
    "    'accuracy': float(metrics['accuracy']),\n",
    "    'precision': float(metrics['precision']),\n",
    "    'recall': float(metrics['recall']),\n",
    "    'f1': float(metrics['f1']),\n",
    "    'roc_auc': float(metrics['roc_auc']),\n",
    "    'pr_auc': float(metrics['pr_auc']),\n",
    "    'threshold_used': 0.5,\n",
    "    'optimal_threshold': float(best_threshold),\n",
    "    'optimal_f1': float(best_f1)\n",
    "}\n",
    "\n",
    "save_model(model, vectorizer, scaler, final_metrics)\n",
    "save_metrics(final_metrics, 'models/metrics.json')\n",
    "\n",
    "print('✅ Modelo final guardado con métricas reales')\n",
    "print(json.dumps(final_metrics, indent=2))"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 11. Prueba Rápida de Inferencia"
   ]
  ],
